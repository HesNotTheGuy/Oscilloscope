{
  "name": "sound-lab",
  "productName": "Sound Lab",
  "version": "1.7.1",
  "description": "Sound Lab: see and play with sound",
  "repository": {
    "type": "git",
    "url": "https://github.com/HesNotTheGuy/Oscilloscope.git"
  },
  "homepage": "https://github.com/HesNotTheGuy/Oscilloscope",
  "bugs": {
    "url": "https://github.com/HesNotTheGuy/Oscilloscope/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "screenshots": "electron screenshot.js",
    "dist": "electron-builder --win",
    "dist:installer": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.hesnottheguy.soundlab",
    "productName": "Sound Lab",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "index.html",
      "display.html",
      "splash.html",
      "style.css",
      "src/**/*",
      "main.js",
      "preload.js",
      "preload-display.js",
      "logo.svg",
      "icon.ico",
      "icon.png"
    ],
    "icon": "icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.music",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sound Lab",
      "installerHeader": "",
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^43.8.4",
    "electron-builder": "^25.0.0",
    "vitest": "^4.1.4"
  }
}
